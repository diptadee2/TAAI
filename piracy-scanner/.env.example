# Copy to .env (never commit .env).
# From https://my.telegram.org > API development tools, logged in with the SPARE number.
TG_API_ID=
TG_API_HASH=
# The spare number, with country code, e.g. +91XXXXXXXXXX
TG_PHONE=
# Same values as the site's .env (the service_role key).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
